{
  "name": "nodo-sur-proyectos",
  "version": "2.0.0",
  "description": "Entrega final del reto de Desarrollo Full-Stack: gestor de proyectos de Nodo Sur Soluciones Digitales (API REST con Express, MongoDB y JWT con roles, y frontend con React y React Router).",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "debug": "node --inspect backend/server.js",
    "test": "jest --runInBand",
    "test:cobertura": "jest --runInBand --coverage",
    "build": "npm install --prefix frontend --include=dev && npm run build --prefix frontend",
    "seed": "node backend/scripts/seed.js",
    "db:local": "node backend/scripts/db-local.js",
    "promover-admin": "node backend/scripts/promover-admin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Alexis Ayala",
  "license": "ISC",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
