# Copia este archivo como .env y completa los valores. El archivo .env nunca se sube a Git.
PORT=3000
# Local (npm run db:local): mongodb://127.0.0.1:27017/nodo_sur_proyectos
# Nube: cadena de conexión de MongoDB Atlas
MONGODB_URI=
# Cadena larga y aleatoria; sin ella el servidor no arranca
JWT_SECRET=
JWT_EXPIRES_IN=30m
# Origen permitido por CORS; * solo para pruebas locales
CORS_ORIGIN=*
# Contraseña de los usuarios de ejemplo (solo para npm run seed)
SEED_PASSWORD=
# Opcional: API de tipo de cambio (por defecto https://api.frankfurter.dev/v1)
FRANKFURTER_URL=
# Opcional: máximo de intentos de login/registro por IP cada 15 minutos (por defecto 10)
LIMITE_INTENTOS=
